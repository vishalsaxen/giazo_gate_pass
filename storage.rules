rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['vishalsaxen@gmail.com'];
    }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isGuard() { return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && profile().role == 'guard'; }

    // Visitor photos: guards upload, any signed-in member of the society app can view.
    match /visitors/{file} {
      allow read: if signedIn();
      allow create: if (isGuard() || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Guard check-in selfies: the guard who took it and the Super Admin can see it.
    match /attendance/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isGuard() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    function notGuard() { return signedIn() && !isGuard(); }

    // UPI QR code for dues: residents and the Super Admin, never guards.
    match /settings/{file} {
      allow read: if notGuard();
      allow write: if isAdmin();
    }

    // Payment receipts: the resident who uploaded them and the Super Admin.
    match /receipts/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && !isGuard()
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }

    // Our Nest photos: residents and the Super Admin, never guards.
    match /nest/{uid}/{file} {
      allow read: if notGuard();
      allow create: if signedIn() && request.auth.uid == uid && !isGuard()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // KYC documents: only the resident who uploaded them and the Super Admin can see them.
    match /kyc/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }
  }
}
